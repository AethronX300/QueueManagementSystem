<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="QueueManagementSystem.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - QueueFlow</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Site.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">

        <!-- ========= TOP NAVBAR ========= -->
        <nav class="top-navbar">
            <div class="nav-left">
                <!-- Hamburger Toggle Button (only shown when sidebar is visible) -->
                <button id="sidebarToggleBtn" class="sidebar-toggle-btn" onclick="toggleSidebar()" title="Toggle Sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <!-- Brand -->
                <div class="nav-brand">
                    <i class="fas fa-layer-group"></i>
                    <span>QueueFlow</span>
                </div>
            </div>

            <!-- Right side: user info, logout -->
            <div class="nav-right">
                <asp:Panel ID="pnlLoggedIn" runat="server" Visible="false" CssClass="nav-user-info">
                    <span class="nav-business-name">
                        <i class="fas fa-building"></i>
                        <asp:Label ID="lblBusinessName" runat="server" />
                    </span>
                    <span class="nav-user">
                        <i class="fas fa-user-circle"></i>
                        <asp:Label ID="lblUsername" runat="server" />
                    </span>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-logout" OnClick="btnLogout_Click">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </asp:LinkButton>
                </asp:Panel>
            </div>
        </nav>

        <!-- ========= BODY WRAPPER ========= -->
        <div class="main-wrapper" id="mainWrapper">

            <!-- SIDEBAR -->
            <asp:Panel ID="pnlSidebar" runat="server" Visible="false" CssClass="sidebar">
                <div class="sidebar-header">
                    <asp:Label ID="lblModuleType" runat="server" CssClass="module-badge" />
                </div>
                <nav>
                    <ul class="sidebar-menu">
                        <li>
                            <asp:HyperLink ID="lnkDashboard" runat="server" CssClass="sidebar-link">
                                <i class="fas fa-tachometer-alt"></i>
                                <span class="link-text">Dashboard</span>
                            </asp:HyperLink>
                        </li>
                        <li>
                            <asp:HyperLink ID="lnkNewToken" runat="server" CssClass="sidebar-link">
                                <i class="fas fa-ticket-alt"></i>
                                <span class="link-text">New Token</span>
                            </asp:HyperLink>
                        </li>
                        <li>
                            <asp:HyperLink ID="lnkQueueDisplay" runat="server" CssClass="sidebar-link">
                                <i class="fas fa-list-ol"></i>
                                <span class="link-text">Queue / Status</span>
                            </asp:HyperLink>
                        </li>
                        <li>
                            <asp:HyperLink ID="lnkReports" runat="server" CssClass="sidebar-link" NavigateUrl="~/Reports.aspx">
                                <i class="fas fa-chart-bar"></i>
                                <span class="link-text">Reports</span>
                            </asp:HyperLink>
                        </li>
                        <li>
                            <asp:HyperLink ID="lnkPayment" runat="server" CssClass="sidebar-link" NavigateUrl="~/PaymentSim.aspx">
                                <i class="fas fa-credit-card"></i>
                                <span class="link-text">Payment</span>
                            </asp:HyperLink>
                        </li>
                    </ul>
                </nav>

                <!-- Collapse button at the bottom of sidebar -->
                <div class="sidebar-footer">
                    <button class="sidebar-collapse-btn" onclick="toggleSidebar()" title="Collapse sidebar">
                        <i class="fas fa-chevron-left" id="collapseIcon"></i>
                        <span class="link-text">Collapse</span>
                    </button>
                </div>
            </asp:Panel>

            <!-- MAIN CONTENT AREA -->
            <div class="content-area" id="contentArea">
                <div class="content-inner">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </div>

        </div>

        <!-- FOOTER -->
        <footer class="site-footer">
            <p>&copy; <%= DateTime.Now.Year %> QueueFlow &mdash; Scalable Queue Management System</p>
        </footer>

    </form>

    <!-- ========= SIDEBAR TOGGLE SCRIPT ========= -->
    <script>
        // Read saved state from localStorage on page load
        (function () {
            if (localStorage.getItem('sidebarCollapsed') === 'true') {
                document.body.classList.add('sidebar-collapsed');
                var icon = document.getElementById('collapseIcon');
                if (icon) icon.className = 'fas fa-chevron-right';
            }
        })();

        function toggleSidebar() {
            var body = document.body;
            var icon = document.getElementById('collapseIcon');
            var isCollapsed = body.classList.toggle('sidebar-collapsed');

            // Flip the chevron icon direction
            if (icon) {
                icon.className = isCollapsed ? 'fas fa-chevron-right' : 'fas fa-chevron-left';
            }

            // Save preference in localStorage so it persists across pages
            localStorage.setItem('sidebarCollapsed', isCollapsed);
        }
    </script>
</body>
</html>
